# FloGuard FastAPI — set these on Render (or local backend/.env). Never commit real secrets.

# Required
MONGO_URL=mongodb+srv://USER:PASS@cluster.mongodb.net
DB_NAME=floguard
JWT_SECRET=generate-a-long-random-string

# Admin seed (both required to create/update admin user)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=use-a-strong-unique-password
# FORCE_ADMIN_PASSWORD_RESET=true   # only when intentionally rotating password

# CORS (comma-separated origins, no spaces needed but allowed)
CORS_ORIGINS=https://www.floguardfl.com,https://floguardfl.com

# Email (optional but required for lead notifications)
RESEND_API_KEY=
SENDER_EMAIL=onboarding@resend.dev
LEAD_NOTIFICATION_EMAIL=heath@hdconnex.com

# Local/dev only — never set in production
# ALLOW_INSECURE_JWT=true
