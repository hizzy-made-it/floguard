# FloGuard FastAPI — set these on Render (or local backend/.env). Never commit real secrets.

# Required
MONGO_URL=mongodb+srv://USER:PASS@cluster.mongodb.net
DB_NAME=floguard
JWT_SECRET=generate-a-long-random-string

# Admin seed (both required to create/update admin user)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=use-a-strong-unique-password
# FORCE_ADMIN_PASSWORD_RESET=true   # only when intentionally rotating password

# CORS — comma-separated origins only. No quotes, no trailing slashes.
# Production floguardfl.com origins are always allowed in code even if this is wrong/empty.
# Add extra origins here (local dev, Cloudflare Pages preview):
# CORS_ORIGINS=http://localhost:3000,https://floguardfl.pages.dev
CORS_ORIGINS=https://www.floguardfl.com,https://floguardfl.com

# Email (required for lead notifications to reach your inbox)
# RESEND_API_KEY: from the Resend account where hdconnex.com is a verified domain.
RESEND_API_KEY=
# Must be on a Resend-verified domain. Any @resend.dev sender is ignored in code.
SENDER_EMAIL=FloGuard Leads <leads@hdconnex.com>
# Comma-separated; every address gets each lead. Reply-To is set to the homeowner.
LEAD_NOTIFICATION_EMAIL=heath@hdconnex.com

# Local/dev only — never set in production
# ALLOW_INSECURE_JWT=true
