# FLOGUARD SALES REV — environment variables (names only; set real values in Vercel / .env)

# Supabase (same project as HD, ISOLATED bucket)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ACADEMY_STORAGE_BUCKET=floguard-academy

# Data backend: storage | postgres | dual | auto
ACADEMY_DATA_BACKEND=storage
ACADEMY_DEFAULT_ORG_SLUG=floguard

# Auth / admin — generate FRESH values (never reuse HD's; sessions would be cross-valid)
ACADEMY_SESSION_SECRET=
ACADEMY_SYNC_SECRET=
ACADEMY_ADMIN_PIN=
ACADEMY_ADMIN_USERNAMES=heath,hizzy
ACADEMY_DEFAULT_TOKEN_LIMIT=50000

# AI coach
OPENAI_API_KEY=

# CORS allowlist extension (comma-separated)
CORS_ORIGINS=https://floguardfl.com,https://www.floguardfl.com,https://crm.floguardfl.com
