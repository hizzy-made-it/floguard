# FLOGUARD SALES REV — environment variables (names only; set real values in Vercel / .env)

# Supabase — FloGuard project only (gphlrnctrtbrpspmzaxw). Never thecolony-ok.
SUPABASE_URL=https://gphlrnctrtbrpspmzaxw.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
ACADEMY_STORAGE_BUCKET=floguard-academy

# Postgres URI for FSI SQL apply / ingest scripts (Dashboard → Database → Connection string URI).
# Not required for Flood Map fixtures; required for real parcel_risk rows.
# DATABASE_URL=postgresql://postgres.[ref]:[PASSWORD]@aws-0-....pooler.supabase.com:6543/postgres

# Data backend: storage | postgres | dual | auto
ACADEMY_DATA_BACKEND=storage
ACADEMY_DEFAULT_ORG_SLUG=floguard

# Auth / admin — generate FRESH values (never reuse HD's; sessions would be cross-valid)
ACADEMY_SESSION_SECRET=
ACADEMY_SYNC_SECRET=
ACADEMY_ADMIN_PIN=
ACADEMY_ADMIN_USERNAMES=heath,hizzy
ACADEMY_DEFAULT_TOKEN_LIMIT=50000

# AI coach
OPENAI_API_KEY=

# Optional: BatchData property skip-trace for Enrich contacts (phone/email on tax-roll leads).
# Without this key, enrich uses free web search only.
# BATCHDATA_API_KEY=
# Alias read by the code when BATCHDATA_API_KEY is unset (keep one of the two).
# BATCH_DATA_API_KEY=
# NOTE: BATCHDATA_API_URL is NOT read by any code (the skip-trace URL is hard-coded); kept as a comment only.
# BATCHDATA_API_URL=https://api.batchdata.com

# CORS allowlist extension (comma-separated)
CORS_ORIGINS=https://floguardfl.com,https://www.floguardfl.com,https://crm.floguardfl.com

# Optional: Trestle (trestleiq.com) number verification for Enrich contacts — line type,
# activity score, TCPA litigator add-on (extra charge; must be enabled on the key), and
# reverse-phone owner match. Trestle verifies numbers found elsewhere; it does not find them.
# TRESTLE_API_KEY=
# TRESTLE_API_URL=https://api.trestleiq.com

# Estimates (agent G). Names only; see docs/handoff/G.md.
# Base URL used in customer proposal links (default https://crm.floguardfl.com)
# ESTIMATE_PUBLIC_BASE_URL=https://crm.floguardfl.com
# Default validity in days when a rep does not pick a date (default 30; owner decision)
# ESTIMATE_DEFAULT_VALID_DAYS=30

# ---- Added by review R1 (2026-11-19): every remaining variable the code reads -----------------

# Hard daily cap on PAID enrichment lookups (BatchData + Trestle HTTP calls) for the whole
# deployment, per America/New_York day. Default 200; 0 turns paid lookups off. Deployment-wide only
# once fsi/sql/022_enrich_daily_spend.sql is applied (per-instance memory otherwise).
# ENRICH_DAILY_PAID_CAP=200

# Required by api/cron-rainfall.js (refuses to run without it). Vercel sends it as a Bearer token on cron calls.
# CRON_SECRET=

# Alias for SUPABASE_URL (read when SUPABASE_URL is unset). Do not set both to different projects.
# NEXT_PUBLIC_SUPABASE_URL=

# Local dev server port (scripts/dev-server.mjs). Default 3300.
# PORT=3300

# FSI pipeline / ingest scripts (fsi/pipeline/*.py, scripts/ingest-volusia-parcels.mjs). Not used by
# the Vercel functions.
# Rain source for `python -m pipeline.rainfall`: open_meteo (default) | mrms (NOAA radar, needs GDAL).
# FSI_RAIN_SOURCE=open_meteo
# County FIPS for the rainfall state row (default 12127, Volusia).
# FSI_COUNTY_FIPS=12127
# ArcGIS parcel layer URL override for the parcel ingest (default: Volusia appraiser layer).
# FSI_PARCEL_LAYER_URL=
# Page size for the parcel ingest ArcGIS queries (default 500, max 1000).
# FSI_PAGE_SIZE=500
