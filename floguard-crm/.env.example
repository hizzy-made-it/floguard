# FLOGUARD SALES REV — environment variables (names only; set real values in Vercel / .env)

# Supabase — FloGuard project only (gphlrnctrtbrpspmzaxw). Never thecolony-ok.
SUPABASE_URL=https://gphlrnctrtbrpspmzaxw.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
ACADEMY_STORAGE_BUCKET=floguard-academy

# Postgres URI for FSI SQL apply / ingest scripts (Dashboard → Database → Connection string URI).
# Not required for Flood Map fixtures; required for real parcel_risk rows.
# DATABASE_URL=postgresql://postgres.[ref]:[PASSWORD]@aws-0-....pooler.supabase.com:6543/postgres

# Data backend: storage | postgres | dual | auto
ACADEMY_DATA_BACKEND=storage
ACADEMY_DEFAULT_ORG_SLUG=floguard

# Auth / admin — generate FRESH values (never reuse HD's; sessions would be cross-valid)
ACADEMY_SESSION_SECRET=
ACADEMY_SYNC_SECRET=
ACADEMY_ADMIN_PIN=
ACADEMY_ADMIN_USERNAMES=heath,hizzy
ACADEMY_DEFAULT_TOKEN_LIMIT=50000

# AI coach
OPENAI_API_KEY=

# Optional: BatchData property skip-trace for Enrich contacts (phone/email on tax-roll leads).
# Without this key, enrich uses free web search only.
# BATCHDATA_API_KEY=
# BATCHDATA_API_URL=https://api.batchdata.com

# CORS allowlist extension (comma-separated)
CORS_ORIGINS=https://floguardfl.com,https://www.floguardfl.com,https://crm.floguardfl.com
