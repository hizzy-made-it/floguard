# LeadAgent environment — copy to .env and fill in

# LLM (used for drafting; leave empty for template-only drafts)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Or xAI:
# OPENAI_BASE_URL=https://api.x.ai/v1
# OPENAI_MODEL=grok-2-latest
# OPENAI_API_KEY=xai-...

# Apify enrichment
APIFY_TOKEN=
# Max USD per day for Apify (soft guard)
APIFY_DAILY_BUDGET_USD=5.0
# dry_run never calls Apify
APIFY_DRY_RUN=true

# Paths
LEADAGENT_DB=data/leadagent.db
LEADAGENT_CONFIG_DIR=config

# Brave CDP (local browser with logged-in sessions)
BRAVE_CDP_URL=http://127.0.0.1:9222
BRAVE_USER_DATA_DIR=
# e.g. C:\Users\YOU\AppData\Local\LeadAgent\BraveProfile

# Safety
DAILY_SEND_CAP=25
REQUIRE_SEND_CONFIRMATION=true

# FloGuard CRM shared leads store (leadagent sync push/pull/status)
# Must match ACADEMY_SYNC_SECRET configured on Vercel.
# Production CRM API (Vercel project floguard-crm, host crm.floguardfl.com)
ACADEMY_SYNC_URL=https://crm.floguardfl.com/api/academy-leads
ACADEMY_SYNC_SECRET=

# BatchData property skip-trace (residential owner phone/email)
# Key must have Property Skip Trace API permission enabled in the dashboard.
BATCHDATA_API_KEY=
BATCHDATA_API_URL=https://api.batchdata.com
