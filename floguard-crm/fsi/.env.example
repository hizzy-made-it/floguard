# FloGuard FSI — environment variables (names only; real values in Vercel / .env)

# Postgres + PostGIS. Same Supabase project as the CRM, separate table.
DATABASE_URL=

# Supabase (browser client reads parcel_risk through RLS-protected views only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Rainfall source: open-meteo | mrms
FSI_RAINFALL_SOURCE=open-meteo

# County scope for the first cut (spec locks this to Volusia)
FSI_COUNTY_FIPS=12127

# Cron auth — reject unsigned calls to the daily refresh endpoint
FSI_CRON_SECRET=

# Object storage for DEM tiles and generated PMTiles
S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Error reporting
SENTRY_DSN=
