# Public frontend → FastAPI backend origin (no trailing slash, no /api suffix).
# Used by src/lib/api.js as `${REACT_APP_BACKEND_URL}/api`.
# Cloudflare Pages: set this in Project Settings → Environment variables (Production + Preview).
REACT_APP_BACKEND_URL=https://floguard-backend.onrender.com

# Optional GA4 measurement ID (loads Analytics only when set)
# REACT_APP_GA_MEASUREMENT_ID=G-XXXXXXXXXX
